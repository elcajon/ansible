{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Automerge non-major updates (minor, patch, digest, pin) once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Major updates always require manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Keep Ansible CI on Python <3.15 while ansible-core 2.21 supports controller Python 3.12-3.14; revisit with an Ansible upgrade",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}
